# Server-side only. The publishable key is safe to publish, but used here by the
# Next.js server so Google provider credentials never enter browser JavaScript.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
TIMESLICE_SITE_URL=http://localhost:3001
GOOGLE_BACKEND_URL=http://127.0.0.1:8001
# Eva's WhatsApp/database service. HTTPS in production; no service secrets here.
WHATSAPP_BACKEND_URL=http://127.0.0.1:8000
# Production site URL: https://timeslice-dashboard.vercel.app
# Production backend URL must be HTTPS.

# Request Tasks permission when connecting Google (match backend setting).
GOOGLE_ENABLE_TASKS=false
