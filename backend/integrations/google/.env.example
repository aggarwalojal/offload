# Configure a Google OAuth client of type "Web application".
# Enable Google Calendar API; enable Google Tasks API when using Tasks.
# Register this exact redirect URI in the OAuth client's authorized redirects.
GOOGLE_CLIENT_ID=replace-with-your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback
# Leave false for the first Calendar-only milestone.
GOOGLE_ENABLE_TASKS=false

# Public multi-user backend (server only; never use NEXT_PUBLIC_ for secrets).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-backend-secret-key
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
